{
    "name": "macula-io/macula-php",
    "description": "PHP client for the macula mesh: FFI over macula-go's released libmacula (calls and streams by direct dial, serving, pubsub, node-served content, the DHT)",
    "type": "library",
    "keywords": [
        "macula",
        "mesh",
        "quic",
        "rpc",
        "pubsub",
        "ffi",
        "post-quantum"
    ],
    "homepage": "https://github.com/macula-io/macula-php",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Macula",
            "email": "raf.lefever@erlef.org"
        }
    ],
    "support": {
        "issues": "https://github.com/macula-io/macula-php/issues",
        "source": "https://github.com/macula-io/macula-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-ffi": "*"
    },
    "autoload": {
        "psr-4": {
            "Macula\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Macula\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "scripts": {
        "build": [
            "scripts/fetch_native.sh",
            "scripts/build_teststation.sh"
        ],
        "test": "phpunit",
        "test:live": "phpunit --testsuite=live"
    }
}
