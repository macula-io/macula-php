{
    "name": "macula-io/macula-php-sdk",
    "description": "PHP client for the Macula mesh wire protocol -- a thin FFI binding over macula-go-sdk's compiled C ABI (unary RPC, PubSub, content transfer, streaming RPC, both caller and provider roles)",
    "type": "library",
    "keywords": ["macula", "mesh", "quic", "rpc", "pubsub", "ffi", "wire-protocol"],
    "homepage": "https://github.com/macula-io/macula-php-sdk",
    "license": ["Apache-2.0", "MIT"],
    "authors": [
        {
            "name": "Macula",
            "email": "raf.lefever@erlef.org"
        }
    ],
    "support": {
        "issues": "https://github.com/macula-io/macula-php-sdk/issues",
        "source": "https://github.com/macula-io/macula-php-sdk"
    },
    "require": {
        "php": ">=8.1",
        "ext-ffi": "*"
    },
    "autoload": {
        "psr-4": {
            "Macula\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Macula\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "scripts": {
        "test": "phpunit"
    }
}
