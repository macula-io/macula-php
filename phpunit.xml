<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         defaultTestSuite="offline">
    <!--
        offline (the default, so a bare `composer test` never touches the
        network): tests/PoolTest.php against cabi/cmd/teststation, two
        in-process macula 12 stations (`composer build` builds it). Runs in
        CI on every push.

        live: tests/live, against one real station, run explicitly with
        `composer test:live` and the MACULA_PHP_LIVE_* variables it names.
    -->
    <testsuites>
        <testsuite name="offline">
            <directory>tests</directory>
            <exclude>tests/live</exclude>
        </testsuite>
        <testsuite name="live">
            <directory>tests/live</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
